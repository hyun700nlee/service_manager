<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="Python Service Manager" Language="1042" Version="$(var.ProductVersion)" Manufacturer="Python Service Manager" UpgradeCode="A582E3B4-89C5-4D62-B76D-2D1F07B6EC31">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="더 최신 버전이 이미 설치되어 있습니다." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Python Service Manager">
          <Component Id="EngineServiceComponent" Guid="*" Win64="yes">
            <File Id="EngineExecutable" Source="$(var.SourceDir)\ServiceManagerEngine.exe" KeyPath="yes" />
            <ServiceInstall Id="EngineService" Name="PythonServiceManagerEngine" DisplayName="Python Service Manager Engine"
                            Description="Monitors, schedules and recovers local services and remote jobs."
                            Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                            Account="NT SERVICE\PythonServiceManagerEngine" Password="" />
            <ServiceControl Id="EngineServiceControl" Name="PythonServiceManagerEngine" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
            <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
          </Component>
          <Component Id="ApplicationShortcut" Guid="*" Win64="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="Python Service Manager"
                      Target="[INSTALLFOLDER]ServiceManagerGUI.exe" WorkingDirectory="INSTALLFOLDER" />
            <RegistryValue Root="HKLM" Key="Software\PythonServiceManager" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DataFolder" Name="PythonServiceManager">
          <Component Id="DataDirectoryPermissions" Guid="*" Win64="yes" Permanent="yes">
            <CreateFolder>
              <util:PermissionEx User="SYSTEM" GenericAll="yes" />
              <util:PermissionEx User="Administrators" GenericAll="yes" />
              <util:PermissionEx User="NT SERVICE\PythonServiceManagerEngine" GenericAll="yes" />
            </CreateFolder>
            <RegistryValue Root="HKLM" Key="Software\PythonServiceManager" Name="DataDirectory" Type="string" Value="[DataFolder]" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Python Service Manager" />
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="Python Service Manager" Level="1">
      <ComponentRef Id="EngineServiceComponent" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DataDirectoryPermissions" />
      <ComponentGroupRef Id="ProductFiles" />
    </Feature>
  </Product>
</Wix>
